
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Private user account details and settings.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["collaborator", "admin", "viewer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "type": "object",
      "description": "Unified transaction record for the farm ledger.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string", "enum": ["Health", "Feed", "Utility", "Labour", "Purchase", "Sale", "Miscellaneous"] },
        "subcategory": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "Online", "Credit"] },
        "remarks": { "type": "string" }
      },
      "required": ["id", "date", "category", "totalAmount", "paymentMode"]
    },
    "MonthlyIncome": {
      "title": "MonthlyIncome",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "date", "source", "amount"]
    },
    "MonthlyExpense": {
      "title": "MonthlyExpense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["loan", "card", "private", "household"] }
      },
      "required": ["id", "date", "source", "amount", "category"]
    },
    "TrackedSheep": {
      "title": "TrackedSheep",
      "type": "object",
      "description": "Individual animal tracking for biological and growth records.",
      "properties": {
        "id": { "type": "string" },
        "tagId": { "type": "string" },
        "currentWeight": { "type": "number" },
        "age": { "type": "number" },
        "breed": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "imageUrl": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date" },
        "color": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "tagId"]
    },
    "BankLoan": {
      "title": "BankLoan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bankName": { "type": "string" },
        "totalLoan": { "type": "number" },
        "totalTenure": { "type": "number" },
        "balanceLoan": { "type": "number" },
        "monthlyEmi": { "type": "number" },
        "pendingTenure": { "type": "number" },
        "interest": { "type": "number" },
        "paymentDate": { "type": "string" },
        "startDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "bankName", "totalLoan", "balanceLoan"]
    },
    "CreditCard": {
      "title": "CreditCard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bankName": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "totalLimit": { "type": "number" },
        "outstandingAmount": { "type": "number" },
        "minimumPayment": { "type": "number" }
      },
      "required": ["id", "bankName", "totalLimit", "outstandingAmount"]
    },
    "PrivateDebt": {
      "title": "PrivateDebt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "monthlyInterest": { "type": "number" },
        "yearlyInterest": { "type": "number" }
      },
      "required": ["id", "personName", "amount"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles with role-based access control."
    },
    "/users/{userId}/farmExpenses/{id}": {
      "schema": { "$ref": "#/backend/entities/LedgerEntry" },
      "description": "The master unified farm ledger."
    },
    "/users/{userId}/monthlyIncomes/{id}": {
      "schema": { "$ref": "#/backend/entities/MonthlyIncome" },
      "description": "Income streams for monthly balance sheet."
    },
    "/users/{userId}/monthlyExpenses/{id}": {
      "schema": { "$ref": "#/backend/entities/MonthlyExpense" },
      "description": "Categorized expenses for monthly balance sheet."
    },
    "/users/{userId}/trackedSheep/{id}": {
      "schema": { "$ref": "#/backend/entities/TrackedSheep" },
      "description": "Subcollection for animal growth records."
    },
    "/users/{userId}/bankLoans/{id}": {
      "schema": { "$ref": "#/backend/entities/BankLoan" },
      "description": "Subcollection for bank loan tracking."
    },
    "/users/{userId}/creditCards/{id}": {
      "schema": { "$ref": "#/backend/entities/CreditCard" },
      "description": "Subcollection for credit card tracking."
    },
    "/users/{userId}/privateDebts/{id}": {
      "schema": { "$ref": "#/backend/entities/PrivateDebt" },
      "description": "Subcollection for personal/private loan tracking."
    },
    "/communitySales/{saleId}": {
      "schema": { "type": "object" },
      "description": "Publicly viewable livestock for sale."
    }
  }
}
