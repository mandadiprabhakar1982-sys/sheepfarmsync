{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Private user account details and settings.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["collaborator", "admin", "viewer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "HealthTask": {
      "title": "HealthTask",
      "type": "object",
      "description": "Health-related tasks like vaccinations and deworming.",
      "properties": {
        "id": { "type": "string" },
        "taskName": { "type": "string" },
        "lastAdministered": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "taskName", "lastAdministered", "nextDueDate"]
    },
    "TrackedSheep": {
      "title": "TrackedSheep",
      "type": "object",
      "description": "Individual animal tracking for growth logs.",
      "properties": {
        "id": { "type": "string" },
        "tagId": { "type": "string" },
        "currentWeight": { "type": "number" },
        "age": { "type": "number" }
      },
      "required": ["id", "tagId"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles with role-based access control."
    },
    "/users/{userId}/healthTasks/{id}": {
      "schema": { "$ref": "#/backend/entities/HealthTask" },
      "description": "Subcollection for health records."
    },
    "/users/{userId}/trackedSheep/{id}": {
      "schema": { "$ref": "#/backend/entities/TrackedSheep" },
      "description": "Subcollection for animal growth records."
    },
    "/users/{userId}/livestockPurchases/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for purchase history."
    },
    "/users/{userId}/animalSales/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for sales history."
    },
    "/users/{userId}/feedExpenses/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for feed costs."
    },
    "/users/{userId}/laborExpenses/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for labor costs."
    },
    "/users/{userId}/farmExpenses/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for general expenses."
    },
    "/users/{userId}/deadAnimals/{id}": {
      "schema": { "type": "object" },
      "description": "Subcollection for mortality logs."
    },
    "/communitySales/{saleId}": {
      "schema": { "type": "object" },
      "description": "Publicly viewable livestock for sale."
    }
  }
}
