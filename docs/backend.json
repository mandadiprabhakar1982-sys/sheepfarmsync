{
  "entities": {
    "HealthTask": {
      "title": "HealthTask",
      "type": "object",
      "description": "Records health-related tasks like vaccinations, deworming, and supplements.",
      "properties": {
        "id": { "type": "string" },
        "taskName": { "type": "string", "enum": ["Deworming", "Vaccination", "Vitamin & Liver Support"] },
        "dewormerName": { "type": "string" },
        "vaccineType": { "type": "string" },
        "supplementType": { "type": "string" },
        "dosage": { "type": "string" },
        "lastAdministered": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" },
        "frequency": { "type": "string" }
      },
      "required": ["id", "taskName", "lastAdministered", "nextDueDate"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}/healthTasks/{healthTaskId}": {
      "schema": { "$ref": "#/backend/entities/HealthTask" },
      "description": "User-owned health tasks."
    }
  }
}
