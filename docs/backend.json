
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User account details and settings.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "HealthTask": {
      "title": "HealthTask",
      "type": "object",
      "description": "Records health-related tasks like vaccinations, deworming, and supplements.",
      "properties": {
        "id": { "type": "string" },
        "taskName": { "type": "string", "enum": ["Deworming", "Vaccination", "Vitamin & Liver Support", "Other"] },
        "cost": { "type": "number" },
        "lastAdministered": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "required": ["id", "taskName", "lastAdministered", "nextDueDate"]
    },
    "TrackedSheep": {
      "title": "TrackedSheep",
      "type": "object",
      "description": "Individual animal tracking for weight and growth log.",
      "properties": {
        "id": { "type": "string" },
        "tagId": { "type": "string" },
        "currentWeight": { "type": "number" },
        "age": { "type": "number" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tagId"]
    },
    "PublicSale": {
      "title": "PublicSale",
      "type": "object",
      "description": "A sheep sale record shared with the community marketplace.",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "sellerName": { "type": "string" },
        "saleDate": { "type": "string", "format": "date" },
        "village": { "type": "string" },
        "animalCount": { "type": "number" },
        "askingPrice": { "type": "number" }
      },
      "required": ["id", "sellerId", "animalCount", "askingPrice"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Public profile of a user."
    },
    "/users/{userId}/healthTasks/{healthTaskId}": {
      "schema": { "$ref": "#/backend/entities/HealthTask" },
      "description": "User-owned health tasks."
    },
    "/users/{userId}/trackedSheep/{sheepId}": {
      "schema": { "$ref": "#/backend/entities/TrackedSheep" },
      "description": "Individually tracked flock members."
    },
    "/communitySales/{saleId}": {
      "schema": { "$ref": "#/backend/entities/PublicSale" },
      "description": "Publicly viewable livestock for sale."
    }
  }
}
