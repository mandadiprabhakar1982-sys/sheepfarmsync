/**
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model where all data is private.
 * Access is controlled by ensuring an authenticated user's ID (request.auth.uid)
 * matches the {userId} wildcard present in the document path. This model ensures
 * that users can only ever access their own information.
 *
 * Data Structure:
 * All application data is hierarchically organized under a top-level `users`
 * collection. Each user's specific data, such as livestock purchases, expenses,
 * and sales, is stored in dedicated subcollections under their unique user
 * document path (e.g., /users/{userId}/livestockPurchases/{purchaseId}).
 *
 * Key Security Decisions:
 * - Default Deny: All paths are closed by default. Access is only granted explicitly.
 * - No Public Data: All reads and writes require user authentication.
 * - No User Enumeration: Listing or reading the top-level `/users` collection
 *   is explicitly forbidden to prevent attackers from discovering user IDs.
 * - Path-Based Ownership: Authorization is derived directly from the document
 *   path, which is a fast, reliable, and highly secure method that avoids costly
 *   cross-document reads (`get()`) in rules.
 *
 * Denormalization for Authorization:
 * This ruleset relies on path-based security, a form of denormalization where
 * the owner's ID (`userId`) is part of the document's path. This allows for
 * simple and performant rules like `isOwner(userId)` without needing to read
 * other documents to verify permissions.
 *
 * Structural Segregation:
 * Each data type (e.g., LivestockPurchase, MedicineExpense) is stored in its
 * own dedicated collection under the user's path. This creates a clean separation
 * of concerns and allows for distinct, clear security rules per data type, even
 * though in this case the ownership logic is consistent across all of them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing user ownership.
     * @param userId The user ID to check against the authenticated user.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if a document exists and if the user is the owner.
     * Used for safe update and delete operations.
     * @param userId The owner's user ID from the path.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * On create, validates that the incoming document's `id` field matches the
     * document's ID from the path. Enforces relational integrity.
     * @param docId The document's ID from the path wildcard.
     */
    function isCreatingWithMatchingId(docId) {
      return request.resource.data.id == docId;
    }

    /**
     * On update, ensures that the document's `id` field cannot be changed.
     * Enforces immutability for the primary identifier.
     */
    function isIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    // -------------------------------------------------------------------------
    // User Data Rules
    // -------------------------------------------------------------------------

    /**
     * @description Disallows any access to the root users collection to prevent
     *              user enumeration attacks. Also handles the user's own document.
     * @path        /users/{userId}
     * @allow       (create) An authenticated user creating their own profile/user document.
     *              Example: A new user with uid 'user123' creates `/users/user123`.
     * @deny        (get, list, update, delete) All other operations are denied for security.
     *              Example: User 'user456' trying to read `/users/user123`.
     * @principle   Restricts access to a user's own data tree and enforces self-creation.
     */
    match /users/{userId} {
      allow get: if false;
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;

      /**
       * @description Secures livestock purchase records. Only the owner can manage their records.
       * @path        /users/{userId}/livestockPurchases/{livestockPurchaseId}
       * @allow       (create) The owner creating a new purchase record for themselves.
       * @deny        (update) Another user trying to modify a purchase record.
       * @principle   Enforces document ownership for all operations.
       */
      match /livestockPurchases/{livestockPurchaseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingWithMatchingId(livestockPurchaseId);
        allow update: if isExistingOwner(userId) && isIdImmutable();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Secures medicine expense records. Only the owner can manage their records.
       * @path        /users/{userId}/medicineExpenses/{medicineExpenseId}
       * @allow       (get) The owner reading one of their medicine expense records.
       * @deny        (delete) Another user trying to delete an expense record.
       * @principle   Enforces document ownership for all operations.
       */
      match /medicineExpenses/{medicineExpenseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingWithMatchingId(medicineExpenseId);
        allow update: if isExistingOwner(userId) && isIdImmutable();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Secures feed expense records. Only the owner can manage their records.
       * @path        /users/{userId}/feedExpenses/{feedExpenseId}
       * @allow       (list) The owner listing all their feed expense records.
       * @deny        (create) An unauthenticated user trying to create a record.
       * @principle   Enforces document ownership for all operations.
       */
      match /feedExpenses/{feedExpenseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingWithMatchingId(feedExpenseId);
        allow update: if isExistingOwner(userId) && isIdImmutable();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Secures labor expense records. Only the owner can manage their records.
       * @path        /users/{userId}/laborExpenses/{laborExpenseId}
       * @allow       (update) The owner updating one of their existing labor expense records.
       * @deny        (get) Another user trying to read a labor expense record.
       * @principle   Enforces document ownership for all operations.
       */
      match /laborExpenses/{laborExpenseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingWithMatchingId(laborExpenseId);
        allow update: if isExistingOwner(userId) && isIdImmutable();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Secures animal sale records. Only the owner can manage their records.
       * @path        /users/{userId}/animalSales/{animalSaleId}
       * @allow       (delete) The owner deleting one of their animal sale records.
       * @deny        (list) Another user trying to list animal sales.
       * @principle   Enforces document ownership for all operations.
       */
      match /animalSales/{animalSaleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingWithMatchingId(animalSaleId);
        allow update: if isExistingOwner(userId) && isIdImmutable();
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}