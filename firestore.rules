
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // --- GLOBAL COLLABORATIVE ACCESS ---
    // Allow all authenticated shepherds to read and write to the shared pool.
    // This supports both root collections and nested subcollections via Collection Group queries.
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
