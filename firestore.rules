rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COMMUNITY MARKETPLACE ---
    // Publicly viewable by all members, but editable only by the seller.
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- ALL OTHER PRIVATE COLLECTIONS ---
    // (livestockPurchases, feedExpenses, medicineExpenses, laborExpenses, etc.)
    // Strictly private: users can only see and edit their own data.
    match /{collectionName}/{docId} {
      // Allow creation if they attach their own UID as ownerId
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Allow reading/editing only if they are the owner
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}