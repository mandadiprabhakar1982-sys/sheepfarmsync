rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any authenticated user to read and write any document.
    // This supports the fully collaborative community model where farmers share data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Explicitly authorize Collection Group queries for shared farm metrics.
    // This resolves permission errors when searching across all user subcollections.
    match /{path=**}/livestockPurchases/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/animalSales/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/feedExpenses/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/medicineExpenses/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/laborExpenses/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/deadAnimals/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/trackedSheep/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/farmExpenses/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/healthTasks/{id} { allow read, write: if request.auth != null; }
    
    // Community Marketplace
    match /communitySales/{id} {
      allow read, write: if request.auth != null;
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}