rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-specific data: Only the owner can read or write their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community Sales: Publicly readable for marketplace, but only owner can write
    match /communitySales/{saleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}