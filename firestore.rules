rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based helper: Safely checks if the user has the 'collaborator' role
    function isCollaborator() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == 'collaborator';
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLABORATIVE DATA (Shared for Benchmarking) ---
    // These drive the "Merged View" financial stats
    match /{path=**}/livestockPurchases/{id} { allow read, write: if isCollaborator(); }
    match /{path=**}/animalSales/{id} { allow read, write: if isCollaborator(); }
    match /{path=**}/feedExpenses/{id} { allow read, write: if isCollaborator(); }
    match /{path=**}/medicineExpenses/{id} { allow read, write: if isCollaborator(); }
    match /{path=**}/laborExpenses/{id} { allow read, write: if isCollaborator(); }

    // --- PRIVATE DATA (Owner Restricted) ---
    // Individual animal tracking, specific health tasks, and misc expenses
    match /users/{userId}/deadAnimals/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /users/{userId}/trackedSheep/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /users/{userId}/farmExpenses/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /users/{userId}/healthTasks/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }

    // --- COMMUNITY MARKETPLACE ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}