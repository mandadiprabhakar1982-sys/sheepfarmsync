rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLABORATIVE MERGED VIEW ---
    // Allow any authenticated shepherd to read any record across the entire database,
    // including nested subcollections (required for Merged Collaborative View).
    match /{path=**} {
      allow read: if isSignedIn();
    }

    // --- NESTED SUBCOLLECTION ACCESS ---
    // Specifically allow writing to user subcollections (purchases, trackedSheep, etc.).
    // We allow any signed-in user to write to ensure the merged collaborative pool is accessible.
    match /users/{userId}/{collectionName}/{docId} {
      allow write: if isSignedIn();
    }
  }
}