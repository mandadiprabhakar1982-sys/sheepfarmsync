rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COMMUNITY MARKETPLACE ---
    // Public read, private write (owner only)
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- PRIVATE FARM COLLECTIONS ---
    // Strictly private: Users only see and edit their own data.
    // This matches: livestockPurchases, animalSales, feedExpenses, medicineExpenses, 
    // laborExpenses, deadAnimals, trackedSheep, farmExpenses, healthTasks
    match /{collectionName}/{docId} {
      // Allow creation if they attach their own UID as ownerId
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Allow reading (get/list), updating, and deleting only if they are the owner
      // NOTE: Queries MUST include a where('ownerId', '==', auth.uid) filter to succeed.
      allow read, update, delete: if isSignedIn() && (
        resource == null || resource.data.ownerId == request.auth.uid
      );
    }
  }
}