rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLABORATIVE SHARED MODEL ---
    // This allows all authenticated shepherds to read and write to the shared pool.
    // The recursive wildcard {document=**} covers both top-level collections
    // and nested subcollections (supporting Collection Group queries).
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
    
    // Explicitly allow Community Marketplace access
    match /communitySales/{saleId} {
      allow read, write: if isSignedIn();
    }
  }
}