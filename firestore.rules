/**
 * SheepSync Pro - Private-First Security Rules
 * 
 * CORE PRIVACY: All user data is strictly private and only accessible by the owner.
 * MARKETPLACE: Community marketplace remains public for explicitly shared listings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles & Farm Data (Private)
    // Strictly restricted to the owner of the data for both READ and WRITE.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Community Marketplace (Public)
    // Only data explicitly posted to this top-level collection is viewable by others.
    match /communitySales/{saleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}