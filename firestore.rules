rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated via Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // --- SHARED COMMUNITY FARM MODEL ---
    // This allows all authenticated shepherds to share the same database.
    // It enables real-time data merging and collaborative management.
    
    match /{collectionName}/{docId} {
      allow read, write: if isSignedIn();
    }

    // User profiles remain private to the individual
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}