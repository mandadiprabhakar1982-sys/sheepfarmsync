rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLABORATIVE SHARED MODEL ---
    // Allow any signed-in user to read and write any document.
    // This supports the Merged Dashboard view where all shepherds share data.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // Explicitly allow Marketplace access (redundant but for clarity)
    match /communitySales/{saleId} {
      allow read, write: if isSignedIn();
    }
  }
}