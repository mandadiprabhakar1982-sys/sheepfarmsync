/**
 * SheepSync Pro - Community-Open Security Rules
 * 
 * CORE PRIVACY: Farm data is now readable by all signed-in users for transparency 
 * and community benchmarking.
 * OWNERSHIP: Only the original creator can modify or delete their records.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Data - Public Read, Private Write
    match /users/{userId} {
      // Anyone signed in can read any farm profile to foster community learning
      allow get, list: if isSignedIn();
      // Only the owner can manage their own profile
      allow create, update, delete: if isOwner(userId);

      // Subcollections (Purchases, Health, Sheep, etc.)
      match /{allSubcollections=**} {
        // Global visibility for all farm records
        allow read: if isSignedIn();
        // Modification restricted to the owner
        allow write: if isOwner(userId);
      }
    }

    // Community Marketplace
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
  }
}