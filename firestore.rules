rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fully Collaborative Model: Any authenticated user can read and write all documents.
    // This wildcard handles all paths including nested subcollections and collection group queries.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Explicitly authorize User Profile reads for anyone (to show seller names in marketplace).
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
