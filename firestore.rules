/**
 * SheepSync Pro - Community-Open Security Rules
 * 
 * CORE PRIVACY: Farm data is readable by all signed-in users to enable 
 * community-wide benchmarking and shared intelligence.
 * OWNERSHIP: Only the original creator (owner) can create, update, or delete their records.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Read Access (Method: get, list)
    // Required for the "Community-Open" benchmarking model.
    // Explicitly allow list at the root to support collectionGroup queries.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // 2. Explicit Collection Group Rules
    // These ensure the Firestore engine recognizes the collections as globally readable
    // when executing collectionGroup() queries from the client.
    match /{path=**}/livestockPurchases/{id} { allow read: if request.auth != null; }
    match /{path=**}/animalSales/{id} { allow read: if request.auth != null; }
    match /{path=**}/feedExpenses/{id} { allow read: if request.auth != null; }
    match /{path=**}/medicineExpenses/{id} { allow read: if request.auth != null; }
    match /{path=**}/laborExpenses/{id} { allow read: if request.auth != null; }
    match /{path=**}/deadAnimals/{id} { allow read: if request.auth != null; }
    match /{path=**}/trackedSheep/{id} { allow read: if request.auth != null; }
    match /{path=**}/farmExpenses/{id} { allow read: if request.auth != null; }
    match /{path=**}/healthTasks/{id} { allow read: if request.auth != null; }

    // 3. User Profiles & Farm Data (Write Access)
    // Strictly restricted to the owner of the data.
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 4. Community Marketplace (Write Access)
    match /communitySales/{saleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}