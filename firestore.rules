
/**
 * Core Philosophy:
 * Private user data is protected under /users/{userId}.
 * Community data is readable by all authenticated users under /communitySales.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Community Marketplace - Anyone signed in can read, only creators can delete/update
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list, delete: if isOwner(userId);

      match /livestockPurchases/{id} { allow read, write: if isOwner(userId); }
      match /medicineExpenses/{id} { allow read, write: if isOwner(userId); }
      match /feedExpenses/{id} { allow read, write: if isOwner(userId); }
      match /laborExpenses/{id} { allow read, write: if isOwner(userId); }
      match /animalSales/{id} { allow read, write: if isOwner(userId); }
      match /deadAnimals/{id} { allow read, write: if isOwner(userId); }
      match /trackedSheep/{id} { allow read, write: if isOwner(userId); }
      match /farmExpenses/{id} { allow read, write: if isOwner(userId); }
      match /healthTasks/{id} { allow read, write: if isOwner(userId); }
    }
  }
}
