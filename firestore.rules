rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // High-precision role verification
    function hasRole(roles) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // Security Fast-Track for primary administrator to prevent race conditions
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'mprabhakar99@gmail.com' || hasRole(['admin']));
    }

    function isCollaborator() {
      return isSignedIn() && (request.auth.token.email == 'mprabhakar99@gmail.com' || hasRole(['collaborator', 'admin']));
    }

    // --- COMMUNITY MARKETPLACE ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
    }

    // --- PRIVATE USER DATA (Profile Level) ---
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);

      // Matches all subcollections for the shepherd who owns them
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- SHARED OPERATIONAL DATA (Collection Group Access) ---
    match /{path=**}/livestockPurchases/{id} { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/medicineExpenses/{id}  { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/feedExpenses/{id}      { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/laborExpenses/{id}     { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/animalSales/{id}       { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/deadAnimals/{id}       { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/trackedSheep/{id}      { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/farmExpenses/{id}      { allow read, update, delete: if isCollaborator(); }
    match /{path=**}/healthTasks/{id}       { allow read, update, delete: if isCollaborator(); }

    // --- PERSONAL FINANCIAL DATA (Strict Admin Only) ---
    match /{path=**}/bankLoans/{id}         { allow read, update, delete: if isAdmin(); }
    match /{path=**}/creditCards/{id}       { allow read, update, delete: if isAdmin(); }
    match /{path=**}/privateDebts/{id}      { allow read, update, delete: if isAdmin(); }
    match /{path=**}/monthlyIncomes/{id}    { allow read, update, delete: if isAdmin(); }
    match /{path=**}/monthlyExpenses/{id}   { allow read, update, delete: if isAdmin(); }
  }
}