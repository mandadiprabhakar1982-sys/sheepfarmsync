
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCollaborator() {
      // Use a more resilient check that doesn't fail if the document is missing
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && userDoc != null && userDoc.data.role == 'collaborator';
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- COLLABORATIVE MERGED VIEW (Collection Groups) ---
    // Allow users with the 'collaborator' role to perform collectionGroup queries.
    // This match block handles collectionGroup queries by applying to any path.
    match /{path=**} {
      allow read: if isCollaborator();
      // Allow write if signed in for simplified collaboration, 
      // but restricted by user subcollection rules below for security.
      allow write: if isSignedIn();
    }

    // --- NESTED SUBCOLLECTION ACCESS ---
    // Explicitly allow users to write to their own private subcollections.
    match /users/{userId}/{collectionName}/{docId} {
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn();
    }

    // --- SHARED COLLECTIONS ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
