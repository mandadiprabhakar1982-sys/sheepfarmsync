/**
 * SheepSync Pro - Global Collaborative Security Rules
 * 
 * ANY authenticated user can READ and WRITE all data.
 * This enables a fully shared farm management ecosystem.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to list and search across all collections
    // This is required for collectionGroup queries to work at the root.
    allow read, write: if request.auth != null;

    // Explicitly allow all subcollections for authenticated users
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}