rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL PERMISSIONS
    // Allows anyone to read documents for a truly collaborative community experience.
    // Creation and Listing (queries) require authentication.
    match /{document=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow list: if request.auth != null;
    }

    // 2. OWNERSHIP-BASED MODIFICATIONS
    // Users can only update or delete documents they originally created.
    // This applies to private records stored in user subcollections.
    match /users/{userId}/{collectionName}/{docId} {
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ownership check for the community marketplace listings.
    match /communitySales/{saleId} {
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // 3. COLLECTION GROUP AUTHORIZATION (CRITICAL)
    // Explicitly authorize the 'list' method for all collection groups used in the app.
    // The {path=**} syntax is required for collectionGroup() queries to function.
    match /{path=**}/livestockPurchases/{id} { allow list: if request.auth != null; }
    match /{path=**}/animalSales/{id} { allow list: if request.auth != null; }
    match /{path=**}/feedExpenses/{id} { allow list: if request.auth != null; }
    match /{path=**}/medicineExpenses/{id} { allow list: if request.auth != null; }
    match /{path=**}/laborExpenses/{id} { allow list: if request.auth != null; }
    match /{path=**}/deadAnimals/{id} { allow list: if request.auth != null; }
    match /{path=**}/trackedSheep/{id} { allow list: if request.auth != null; }
    match /{path=**}/farmExpenses/{id} { allow list: if request.auth != null; }
    match /{path=**}/healthTasks/{id} { allow list: if request.auth != null; }
    
  }
}