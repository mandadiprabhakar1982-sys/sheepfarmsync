/**
 * SheepSync Pro - Security Rules
 * 
 * CORE PRIVACY: All farm-specific data under /users/{userId} is strictly private.
 * COMMUNITY: Marketplace data under /communitySales is shared but protected against spoofing.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Private Data - Strict Ownership
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);

      // Deeply nested subcollections inherit ownership logic
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community Marketplace
    match /communitySales/{saleId} {
      // Anyone signed in can view community data for benchmarking
      allow read: if isSignedIn();
      
      // Only the authenticated user can create a listing for themselves
      allow create: if isSignedIn() && 
                    request.resource.data.sellerId == request.auth.uid;
      
      // Only the original seller can modify or remove their listing
      allow update, delete: if isSignedIn() && 
                            resource.data.sellerId == request.auth.uid;
    }
  }
}