rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- MERGED COLLABORATIVE MODEL ---
    // Allows all authenticated shepherds to view and contribute to the shared farm records.
    // The recursive wildcard {document=**} ensures that both top-level and nested 
    // subcollections (like users/{id}/trackedSheep) are accessible.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}