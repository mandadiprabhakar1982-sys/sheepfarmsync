rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- COLLABORATIVE SHARED FARM MODEL ---
    // All authenticated users can read and write to any document in the database.
    // This merges all shepherd data into a single shared environment and enables
    // a unified real-time community dashboard without permission errors.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}