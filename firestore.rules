rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Collaborative Access Model:
    // This allows all users to see the shared farm data in real-time.
    // 'read' is set to true to ensure the dashboard can aggregate data from everyone.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
  }
}