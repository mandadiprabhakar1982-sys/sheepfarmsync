rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Explicitly allow authenticated users to perform 'list' and 'get' operations at the root level.
    // This is often required for collectionGroup queries to be authorized.
    allow read, write: if request.auth != null;

    // 2. Fully Collaborative Model: Any authenticated user can read and write all documents.
    // This recursive wildcard matches every document in the database at any depth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // 3. Explicit Collection Group authorization.
    // While the recursive wildcard above covers this, explicitly matching the collection names
    // used in collectionGroup queries provides the most reliable authorization path.
    match /{path=**}/livestockPurchases/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/animalSales/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/feedExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/medicineExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/laborExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/deadAnimals/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/trackedSheep/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/farmExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/healthTasks/{id} {
      allow read, write: if request.auth != null;
    }
    
    // 4. Specific match for the marketplace root collection
    match /communitySales/{saleId} {
      allow read, write: if request.auth != null;
    }

    // 5. User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}