rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based helper: Safely checks if the user has the 'collaborator' role
    function isCollaborator() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == 'collaborator';
    }

    // --- GLOBAL COLLABORATIVE ACCESS ---
    // Allow any authenticated shepherd with the 'collaborator' role to read/write all operational data.
    // This supports Collection Group queries for the Merged Global View.
    match /{path=**} {
      allow read, write: if isCollaborator();
    }

    // --- USER PROFILES ---
    // Explicitly allow users to read/write their own profile to bootstrap the collaborator check
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- COMMUNITY MARKETPLACE ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
