rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based helper: Checks if the user has the 'collaborator' role in their user document
    function isCollaborator() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'collaborator';
    }

    // --- GLOBAL COLLABORATIVE ACCESS ---
    // Allow any authenticated shepherd with the 'collaborator' role to read/write all data.
    // This supports Collection Group queries for the Merged Global View.
    match /{path=**} {
      allow read, write: if isCollaborator();
    }

    // --- USER PROFILES ---
    // Standard access to own profile, plus collaborator read-access for identity verification
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- COMMUNITY MARKETPLACE ---
    // Root level marketplace accessible to all signed-in users
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}