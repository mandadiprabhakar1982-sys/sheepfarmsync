rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLABORATIVE SHARED MODEL ---
    // All authenticated shepherds share a global pool of operational data.
    // We use top-level collections for maximum reliability and performance.
    match /{collectionName}/{document} {
      allow read, write: if isSignedIn();
    }
    
    // Explicitly allow Community Marketplace access
    match /communitySales/{saleId} {
      allow read, write: if isSignedIn();
    }
  }
}