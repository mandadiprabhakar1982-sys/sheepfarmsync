/**
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model where all data is private.
 * Access is controlled by ensuring an authenticated user's ID (request.auth.uid)
 * matches the {userId} wildcard in the document path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list, delete: if false;

      // Ensure that as long as the user owns the parent path, they can manage the data.
      match /livestockPurchases/{id} { allow read, write: if isOwner(userId); }
      match /medicineExpenses/{id} { allow read, write: if isOwner(userId); }
      match /feedExpenses/{id} { allow read, write: if isOwner(userId); }
      match /laborExpenses/{id} { allow read, write: if isOwner(userId); }
      match /animalSales/{id} { allow read, write: if isOwner(userId); }
      match /deadAnimals/{id} { allow read, write: if isOwner(userId); }
      match /trackedSheep/{id} { allow read, write: if isOwner(userId); }
      match /farmExpenses/{id} { allow read, write: if isOwner(userId); }
      match /healthTasks/{id} { allow read, write: if isOwner(userId); }
    }
  }
}
