rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLABORATIVE SHARED MODEL ---
    // This allows all authenticated shepherds to read and write to the shared pool.
    // It covers both top-level collections and nested subcollections (Collection Groups).
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // Explicitly allow Marketplace access
    match /communitySales/{saleId} {
      allow read, write: if isSignedIn();
    }
    
    // Allow collection group queries for the merged dashboard
    match /{path=**}/livestockPurchases/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/animalSales/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/feedExpenses/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/medicineExpenses/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/laborExpenses/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/trackedSheep/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/deadAnimals/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/farmExpenses/{docId} { allow read, write: if isSignedIn(); }
    match /{path=**}/healthTasks/{docId} { allow read, write: if isSignedIn(); }
  }
}