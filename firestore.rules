rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Broad recursive match for the "All Data Merge" community model.
    // This allows all authenticated shepherds to share and manage 
    // the entire farm database together in real-time.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}