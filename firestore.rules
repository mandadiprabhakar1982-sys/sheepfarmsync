rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based helper: Checks if the user is a verified collaborator or admin
    function isCollaborator() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             (get(userPath).data.role == 'collaborator' || get(userPath).data.role == 'admin');
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- GLOBAL COLLABORATIVE PERMISSIONS ---
    // Allows collaborators/admins to manage data across the entire system
    // handles collectionGroup queries and direct document access
    match /{path=**}/livestockPurchases/{id} { allow read, write: if isCollaborator(); }
    match /{path=**}/medicineExpenses/{id}  { allow read, write: if isCollaborator(); }
    match /{path=**}/feedExpenses/{id}      { allow read, write: if isCollaborator(); }
    match /{path=**}/laborExpenses/{id}     { allow read, write: if isCollaborator(); }
    match /{path=**}/animalSales/{id}       { allow read, write: if isCollaborator(); }
    match /{path=**}/deadAnimals/{id}       { allow read, write: if isCollaborator(); }
    match /{path=**}/trackedSheep/{id}      { allow read, write: if isCollaborator(); }
    match /{path=**}/farmExpenses/{id}      { allow read, write: if isCollaborator(); }
    match /{path=**}/healthTasks/{id}       { allow read, write: if isCollaborator(); }

    // --- COMMUNITY MARKETPLACE ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isCollaborator() || (isSignedIn() && (request.resource.data.sellerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
    }
  }
}