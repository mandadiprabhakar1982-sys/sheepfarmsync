rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles and Private Farm Data
    // Only the authenticated owner can access their own folder and all sub-records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Recursive match for all subcollections (purchases, sheep, health, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community Marketplace
    // Anyone signed in can read, and any signed-in user can contribute/edit
    match /communitySales/{saleId} {
      allow read, write: if request.auth != null;
    }
  }
}