rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Fully Collaborative Model: Any authenticated user can read and write all documents.
    // This top-level wildcard is the primary security barrier.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // 2. Explicit Collection Group authorization.
    // Firestore requires specific matches for the collection name when performing 
    // collectionGroup queries to aggregate data across all user subcollections.
    match /{path=**}/livestockPurchases/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/animalSales/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/feedExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/medicineExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/laborExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/deadAnimals/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/trackedSheep/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/farmExpenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/healthTasks/{id} {
      allow read, write: if request.auth != null;
    }

    // 3. User Profiles
    // Profiles are readable by any authenticated user for collaborative attribution,
    // but only the profile owner can modify their own details.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Marketplace
    // The marketplace is a root-level collection shared by everyone.
    match /communitySales/{saleId} {
      allow read, write: if request.auth != null;
    }
  }
}