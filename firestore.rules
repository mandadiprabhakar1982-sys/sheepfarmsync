rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- USER PROFILE & PRIVATE DATA ---
    // This allows a user to read/write their own document and ANY subcollection nested under it.
    // Example path: /users/pjUjan2Su5U91KL035Q1z4qOO7U2/trackedSheep/someDocId
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- COMMUNITY MARKETPLACE (Shared) ---
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
  }
}