rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COMMUNITY MARKETPLACE ---
    // Public listings shared by shepherds
    match /communitySales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- PRIVATE USER DATA ---
    // Securely scoped to individual shepherds
    match /users/{userId}/{collectionName}/{docId} {
      allow create: if isSignedIn() && userId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && userId == request.auth.uid && resource.data.ownerId == request.auth.uid;
    }
    
    // Legacy support for top-level catch-all if needed (matching user's provided snippet)
    match /{collectionName}/{docId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}