rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Explicitly authorize all collaborative collections for the "All Data Merge" community model.
    // This allows all shepherds to share and manage the farm database together.
    
    match /livestockPurchases/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /animalSales/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /feedExpenses/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /medicineExpenses/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /laborExpenses/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /deadAnimals/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /trackedSheep/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /farmExpenses/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /healthTasks/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /communitySales/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Fallback for any other documents
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}