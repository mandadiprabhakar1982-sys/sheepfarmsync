rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Private User Data: Only the authenticated owner can read or write their own documents and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Explicitly allow access to all subcollections (trackedSheep, livestockPurchases, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community Sales: Publicly readable for marketplace, but only owner can write/delete their own listings
    match /communitySales/{saleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}